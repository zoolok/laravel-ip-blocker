{
    "name": "zoolok/laravel-ip-blocker",
    "description": "Laravel package for blocking suspicious IP addresses (anti-spam/anti-scanner). Supports nginx and Apache log parsing.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ip-blocker",
        "security",
        "anti-spam",
        "nginx",
        "apache",
        "firewall"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "ext-pcre": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "moonshine/moonshine": "Optional MoonShine admin panel resource for viewing blocked IPs.",
        "laravel/framework": "Required for full Laravel integration."
    },
    "autoload": {
        "psr-4": {
            "Zoolok\\IpBlocker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zoolok\\IpBlocker\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Zoolok\\IpBlocker\\IpBlockerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
